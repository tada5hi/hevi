{
    "name": "hevi",
    "version": "2.0.2",
    "type": "module",
    "description": "A library to set & bump versions in helm charts",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/hevi.git"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "keywords": [],
    "bin": {
        "hevi": "dist/cli.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "dependencies": {
        "@actions/github": "^9.1.1",
        "citty": "^0.2.2",
        "consola": "^3.4.2",
        "dotenv": "^17.4.2",
        "graph-data-structure": "^4.5.0",
        "hapic": "^3.0.2",
        "locter": "^4.1.1",
        "semver": "^7.8.5",
        "tar": "^7.5.22",
        "tinyexec": "^1.3.1",
        "yaml": "^2.9.1",
        "yauzl": "^3.4.0"
    },
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.2",
        "@tada5hi/eslint-config": "^2.4.0",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^26.6.5",
        "@types/semver": "^7.8.0",
        "@types/yauzl": "^3.4.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.13.0",
        "husky": "^9.1.7",
        "tsdown": "^0.23.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^4.1.10"
    }
}
